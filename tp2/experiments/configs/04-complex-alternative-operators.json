{
  "config_version": 1,
  "input": {"image": "assets/targets/03_complex.png", "working_max_side": 48},
  "representation": {"triangle_count": 30, "canvas_rgb": [255, 255, 255], "alpha_range": [1, 255], "initialization": "uniform_random"},
  "genetic": {
    "population_size": 50,
    "offspring_count": 50,
    "parent_selection": {"method": "boltzmann", "params": {"initial_temperature": 1.0, "final_temperature": 0.05, "decay_rate": 0.05}},
    "crossover": {"method": "one_point", "probability": 0.9, "params": {}},
    "mutation": {"method": "single_gene", "probability": 0.25, "allele_change": {"mode": "global_resample"}},
    "survival": {"strategy": "exclusive", "selection": {"method": "ranking", "params": {}}}
  },
  "fitness": {"metric": "normalized_mse", "epsilon": 1e-12},
  "termination": {"max_generations": 100, "target_nmse": null, "stagnation": null, "max_seconds": null},
  "run": {"seed": 14},
  "output": {"directory": "output/experiments", "metrics_every": 1, "checkpoint_every": null, "render_original_size": true}
}
