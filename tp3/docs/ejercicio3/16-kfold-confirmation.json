{
  "protocol": "kfold-confirmation",
  "fold_count": 5,
  "fold_seed": 0,
  "paired_seeds": [0, 1, 2, 3, 4],
  "checkpoints": [50, 100, 150, 200, 220, 250, 300],
  "run": {
    "name": "frozen-candidate",
    "stage": "kfold-confirmation",
    "architecture": [784, 128, 10],
    "activations": ["tanh", "softmax"],
    "loss": "categorical_cross_entropy",
    "l2_lambda": 0.0,
    "augmentation": {
      "name": "translation_rotation",
      "max_shift": 1,
      "translation_probability": 0.5,
      "max_angle_degrees": 4,
      "rotation_probability": 0.5,
      "seed": 0
    },
    "beta": 1.0,
    "init_scale": 0.5,
    "optimizer": {
      "name": "adam",
      "learning_rate": 0.01,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-8
    },
    "learning_rate_schedule": [
      {"start_epoch": 1, "learning_rate": 0.01},
      {"start_epoch": 151, "learning_rate": 0.003},
      {"start_epoch": 221, "learning_rate": 0.001}
    ],
    "batch_size": 128,
    "max_epochs": 300,
    "model_seed": 0,
    "shuffle_seed": 0,
    "shuffle": true
  }
}
