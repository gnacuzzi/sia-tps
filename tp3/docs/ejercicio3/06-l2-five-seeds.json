      "loss": "categorical_cross_entropy",
      "l2_lambda": 0.0001,
      "beta": 1.0,
      "init_scale": 0.5,
      "optimizer": {
        "name": "adam",
        "learning_rate": 0.01,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-8
      },
      "batch_size": 128,
      "max_epochs": 200,
      "model_seed": 0,
      "shuffle_seed": 0,
      "shuffle": true
    }
  ]
}
